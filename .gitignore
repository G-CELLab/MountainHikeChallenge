# ============================================================
# UNITY .GITIGNORE
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
# ============================================================


# ------------------------------------------------------------
# Unity Generated Folders
# ------------------------------------------------------------
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# Memory & recordings (can be large and/or sensitive)
/[Mm]emoryCaptures/
/[Rr]ecordings/

# IL2CPP generated code
/[Ii][Ll]2[Cc]pp/

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Uncomment to ignore Asset Store Tools plugin
# /[Aa]ssets/AssetStoreTools*


# ------------------------------------------------------------
# IDE & Editor Files
# ------------------------------------------------------------

# JetBrains Rider
/[Aa]ssets/Plugins/Editor/JetBrains*
.idea/
*.sln.DotSettings.user

# Visual Studio
.vs/
ExportedObj/
.consulo/

# Visual Studio Code
.vscode/

# Autogenerated solution/project files
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for the above
*.pidb.meta
*.pdb.meta
*.mdb.meta


# ------------------------------------------------------------
# Build Outputs
# ------------------------------------------------------------
*.apk
*.aab
*.ipa
*.exe
*.x86
*.x86_64
*.app
*.unitypackage
*.unitypackage.meta
*.tmp


# ------------------------------------------------------------
# Logs & Crash Reports
# ------------------------------------------------------------
*.log
sysinfo.txt
crashlytics-build.properties


# ------------------------------------------------------------
# OS Generated Files
# ------------------------------------------------------------

# macOS
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*


# ------------------------------------------------------------
# Secrets & Credentials — NEVER COMMIT THESE
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
google-services.json
GoogleService-Info.plist
secrets.xml
*secret*
*credentials*
ServiceAccountKey.json


# ------------------------------------------------------------
# Package Managers & Build Tools
# ------------------------------------------------------------

# Gradle
.gradle/
local.properties

# Node (if using any JS tooling)
node_modules/
npm-debug.log*
yarn-error.log*


# ------------------------------------------------------------
# Version Control Helpers
# ------------------------------------------------------------
*.orig
*.rej